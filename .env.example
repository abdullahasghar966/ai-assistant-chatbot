# ─────────────────────────────────────────────────────────────
# AI Chatbot Platform — environment variables
# Every value is OPTIONAL. With none set, the app runs in demo mode
# (local mock assistant, in-memory conversation, no auth).
# Add a key to unlock the matching real integration.
# ─────────────────────────────────────────────────────────────

# ── AI — Groq (PRIMARY, active now) ──
# Free, fast, OpenAI-compatible. Get a key at https://console.groq.com/keys (no card).
# Keys start with "gsk_". This is the default live provider.
GROQ_API_KEY=
# Default Groq model (e.g. llama-3.3-70b-versatile, llama-3.1-8b-instant).
GROQ_MODEL=llama-3.3-70b-versatile

# ── AI — Google Gemini (optional) ──
# Get a free key at https://aistudio.google.com/apikey. It MUST start with "AIza".
GOOGLE_AI_API_KEY=
# Default Gemini model (e.g. gemini-2.0-flash, gemini-2.5-flash).
GEMINI_MODEL=gemini-2.0-flash

# ── AI — OpenAI (optional) ──
# Without any AI key, /api/chat streams a local mock reply (Demo mode).
OPENAI_API_KEY=
# Default OpenAI model when a key is present (e.g. gpt-4o, gpt-4o-mini).
OPENAI_MODEL=gpt-4o

# ── NOTE on TLS-inspecting networks (corporate / antivirus / ISP proxies) ──
# If live AI calls fail with UNABLE_TO_VERIFY_LEAF_SIGNATURE, your network re-signs
# HTTPS with a private root CA. `npm run dev` already runs Node with --use-system-ca
# (see scripts/next-with-system-ca.mjs) to trust the OS certificate store. Always use
# `npm run dev` / `npm start`, not bare `next dev`.

# ── Auth — Clerk (Phase 1, deferred / env-gated) ──
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# ── Database — Postgres via Prisma + Neon (Phase 1, deferred) ──
# Demo mode keeps conversations in memory; set this for persistence.
DATABASE_URL=

# ── Real-time — Pusher (Phase 6, deferred) ──
PUSHER_APP_ID=
PUSHER_KEY=
PUSHER_SECRET=
NEXT_PUBLIC_PUSHER_KEY=
NEXT_PUBLIC_PUSHER_CLUSTER=

